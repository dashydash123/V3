# ===== Salesforce (from the existing SFDC script - do not share these) =====
SFDC_CLIENT_ID=PASTE_HERE
SFDC_CLIENT_SECRET=PASTE_HERE
SFDC_REFRESH_TOKEN=PASTE_HERE
SFDC_TOKEN_URL=https://login.salesforce.com/services/oauth2/token
SFDC_INSTANCE_URL=https://ontime.my.salesforce.com
SFDC_API_VERSION=v66.0
# optional filter, e.g.  IsActive = true
SFDC_SOQL_WHERE=

# ===== Flexera (same values as your ADO / custom-field scripts) =====
FLEXERA_TOKEN_URL=PASTE_HERE
FLEXERA_CLIENT_ID=PASTE_HERE
FLEXERA_CLIENT_SECRET=PASTE_HERE
FLEXERA_API_BASE=https://snowatlas-westeurope.flexera.eu

# ===== What to do =====
# extract,update = pull from Salesforce and update Flexera | extract = CSV only | update = from latest CSV
RUN_STEPS=extract,update
SFDC_MATCH_BY=email
SFDC_COLUMNS=IsActive,UserPermissionsSupportUser
SFDC_FIELD_PREFIX=SFDC_
SFDC_DUP_RULE=skip
# test on a few users first; remove the value for the full run
SFDC_LIMIT=5
# yes = write nothing to Flexera, No = write
SFDC_DRY_RUN=yes

# ===== Output + log =====
OUTPUT_DIR=output
LOG_MAX_MB=5
