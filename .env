# Copy to .env and fill in. Take API_BASE_URL and TOKEN_URL from your working ADO -> Flexera script.
API_BASE_URL=https://<same-host-as-your-ADO-script>
TOKEN_URL=https://<same-token-endpoint-as-your-ADO-script>
CLIENT_ID=
CLIENT_SECRET=

FIELD_NAME=abcde
FIELD_VALUE=yes
EMAILS_CSV=test_emails.csv

# true = only shows what it would do; set to false to actually write
DRY_RUN=true
